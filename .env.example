# Copy to .env. Do not commit .env — SOROBAN_SECRET is a hot key.

SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Secret key of the deployer. Leave empty and scripts/deploy-testnet.sh
# will generate one and fund it with Friendbot.
SOROBAN_SECRET=

# SEP-41 token the vault custodies. Leave empty to deploy a fresh SAC.
TOKEN_CONTRACT_ID=

# Smallest accepted deposit, in token stroops.
MIN_DEPOSIT=0

# Filled in by scripts/deploy-testnet.sh. Leave empty on the first run.
FACTORY_ID=
VAULT_ID=
